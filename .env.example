# Copy to .env.local and fill in your values

# Google Sheets (Service Account)
# From your JSON key file: client_email, private_key (paste as one line with \n for newlines)
# Share the sheet with the service account email (Editor access)
# Sheet ID is in the URL: docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_CLIENT_EMAIL=sheet-access@zyra-487207.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1S1zzxjoP-kI0apHUoPkwYCqaso8CuBO95m7XReCgMzQ

# Gmail (for confirmation emails)
# Enable 2FA, then generate App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# Optional: Get notified when someone joins the waitlist
ADMIN_EMAIL=
